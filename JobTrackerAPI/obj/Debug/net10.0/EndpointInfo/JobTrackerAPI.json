    "/api/Personnel/{p_strID}": {
      "get": {
        "tags": [
          "Personnel"
        ],
        "operationId": "GetPersonnelById",
        "parameters": [
          {
            "name": "p_strID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Personnel"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Personnel"
                }
              },
              "text/json": {
